{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🔧 Benchmark TensorStore",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/benchmark_tensorstore.py",
            "remoteRoot": "/workspace/cell_observatory_platform",
            "localRoot": "${workspaceFolder}",
            "args": [
                "databases/test_16_128_128_128_2_hypercubes_database_10k.csv",
                "--num-hypercubes",
                "100",
                "--cpu-counts",
                "1",
                "2",
                "4",
                "8",
                "12",
                "16",
                "--dtype",
                "fp32"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "justMyCode": false
        },
        {
            "name": "🧪 Test Loops",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "remoteRoot": "/workspace/cell_observatory_platform",
            "localRoot": "${workspaceFolder}",
            "args": [
                "-s",
                "-vv",
                "--disable-pytest-warnings",
                "--color=yes",
                "tests/training/test_loops.py"
